{
  "name": "timing",
  "private": true,
  "version": "0.12.6",
  "type": "module",
  "description": "Timing — 桌面悬浮计时条（Tauri 2 + React 19）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check:build": "vite build",
    "check:contract": "node scripts/check-contract.mjs",
    "check:brand": "node scripts/brand-gate.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:doc-numbers": "node scripts/check-doc-numbers.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:mutation": "node scripts/check-mutation-markers.mjs",
    "check:runtime-ids": "node scripts/check-runtime-ids.mjs",
    "check:storage-keys": "node scripts/check-storage-keys.mjs",
    "check:de-patina": "node scripts/check-de-patina.mjs",
    "check:css-hex": "node scripts/check-css-hex.mjs",
    "check:ci-parity": "node scripts/check-ci-parity.mjs",
    "check": "npm run check:ci-parity && npm run typecheck && npm run check:build && npm run check:contract && npm run test:scripts && npm run check:size && npm run check:version && npm run check:doc-numbers && npm run check:layers && npm run check:brand && npm run lint && npm run check:mutation && npm run check:runtime-ids && npm run check:storage-keys && npm run check:de-patina && npm run check:css-hex && npm test",
    "verify": "npm run check && npm run build && npm test",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
