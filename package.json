{
  "name": "tickbar",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "TickBar — 桌面悬浮计时药丸（Tauri 2 + React 19）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check:contract": "node scripts/check-contract.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run typecheck && npm run check:contract && npm run check:size && npm run check:version && npm run check:layers && npm run lint",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:layers": "node scripts/check-layers.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
