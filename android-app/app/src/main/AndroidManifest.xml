<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮小条必须：允许在其他应用上层绘制（用户需在系统设置里手动授予） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 取时长不走后台任务，而是常驻前台服务（Android 8+ 的硬要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知是运行时权限，用于「暂停 / 结束」的常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TickApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timing">

        <!-- configChanges：旋转 / 分屏 / 深色切换都不重建 Activity。
             便利贴编辑是「停手 800ms 才落盘」的，重建一次就丢掉还没写库的最后几句话；
             计时页的 ticker 也会跟着重挂。布局照样跟着新宽度重新 measure（View 体系自己会做），
             环的边长由 TimerPage 的 layout 监听重算。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 悬浮层宿主：小圆点 / 顶部长条都挂在这个服务里 -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_timer_overlay" />
        </service>
    </application>
</manifest>
