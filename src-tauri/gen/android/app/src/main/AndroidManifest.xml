<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用使用时间统计（0.13.0）：特殊权限，运行时弹窗给不了，必须用户在系统「使用情况访问」里手动打开。
         带 tools:ignore 是必须的 —— 这是受保护权限，lint 会报 ProtectedPermissions。 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 应用使用统计要显示「微信」「哔哩哔哩」和它们的图标，就必须能查**任意**包。
         Android 11（API 30）起有「包可见性」限制（targetSdk 35 落在限制内）：
         没声明这条时 `PackageManager.getApplicationInfo(第三方包)` 直接抛
         NameNotFoundException —— 拿不到 ApplicationInfo 就没有名字没有图标，
         前端只能回落到包名尾段（微信显示成 Mm、哔哩哔哩显示成 Bili）。
         症状极像「桥没写对」：**自己和少数系统应用（forceQueryable）有真名，
         第三方一个都没有，零报错零红测试**，0.12.6 真机截图就是这个。
         这条是普通权限，装上即生效，不弹窗、不需要用户在设置里开。 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- V1-Android：倒计时到点 / 待办提醒走系统通知。API 33+ 属于「运行时权限」，
         需先声明再由前端（@tauri-apps/plugin-notification）发起申请；用户拒绝时
         前端降级为应用内提示条（PRD D7），不静默失败。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- V0.12.0 悬浮条：`SYSTEM_ALERT_WINDOW` 是「显示在其他应用上层」，必须在系统设置里
         由用户显式授予（无法在应用内弹权限框）；前台服务用来让窗口在退到后台后继续存在，
         Android 14 起 `specialUse` 类型还要求 manifest 里配 subtype property。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.timing"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.PillService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="悬浮条：在应用之外显示当前计时，点击回到主界面" />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
