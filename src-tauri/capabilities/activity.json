{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "activity",
  "description": "活动分析窗口（自动使用追踪 / 历史 / 统计 / 分类映射 / 工具）。它是一扇独立窗口，能力面与宿主悬浮条分开：只给 core 窗口基础能力、外部链接与本子系统自己的命令白名单。[V0.12.0 融合] 不给 `updater:default`：更新统一走 Timing 的安装包，上游子系统的更新端点指向另一个仓库，留着等于把 Timing 更新成上游产品。`mini` 并入本 capability：它是标题栏「迷你窗」按钮开的第二扇分析窗（同一套命令面），漏授权会出现「窗开了、界面全哑、零日志」；桌面提醒弹窗 `tool-notification` 另有更窄的 activity-tool-notification.json。",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "activity",
    "mini"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "opener:default",
    "activity-window-commands",
    "activity-todo-notes",
    "activity-host-bridge",
    "activity-host-settings",
    "host-theme-read",
    "activity-host-data",
    "activity-host-tags",
    "dialog:allow-open"
  ]
}
