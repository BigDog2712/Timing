      "glassPanelBg":   { "dark": "color-mix(in srgb, #0E0F12 94%, transparent)", "light": "color-mix(in srgb, #F2F3F5 97%, transparent)", "type": "color", "description": "浮层玻璃底（94% / 97%）" },
      "glassHoverBg":   { "dark": "color-mix(in srgb, #0E0F12 74%, transparent)", "light": "color-mix(in srgb, #F2F3F5 86%, transparent)", "type": "color", "description": "小条悬停板玻璃底（74%）" },
      "glassBlur":      { "value": "18px", "type": "dimension", "description": "菜单 / 事项窗口玻璃模糊半径" },
      "glassBlurSm":    { "value": "14px", "type": "dimension", "description": "悬停板玻璃模糊半径" },
      "glassSaturate":  { "value": "150%", "type": "percentage", "description": "玻璃饱和度提升" },
      "insetHighlight": { "dark": "inset 0 1px 0 rgba(255,255,255,0.06)", "light": "inset 0 1px 0 rgba(255,255,255,0.90)", "type": "shadow", "description": "选中段 / 悬停板顶部内高光" }
    }
  },

  "typography": {
    "fontFamily": {
      "ui": {
        "value": "\"Microsoft YaHei UI\", \"Microsoft YaHei\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
