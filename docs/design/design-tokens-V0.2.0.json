        "solidDark":  { "value": "#E1292F", "type": "color", "description": "AC-53：深色 danger 实心底专用（白字 4.61:1；#E5484D 作实心底白字仅 3.91）" },
        "solidLight": { "value": "#D02C33", "type": "color", "description": "浅色 danger 实心底（＝ deep，白字 5.13:1）" }
      },
