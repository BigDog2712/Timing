      "btnDangerInk":   { "dark": "#FFFFFF", "light": "#FFFFFF", "type": "color", "description": "danger 实心按钮字（配合 dangerSolid 双主题 ≥4.5）" },
      "btnSolidBg":     { "ref": "semantic.solidBg" },
      "btnSolidInk":    { "ref": "semantic.solidInk" },
      "iconBtnInk":     { "ref": "semantic.ink3" },
      "iconBtnHoverBg": { "ref": "semantic.bgFieldHi" },
      "iconBtnDangerBg":{ "ref": "semantic.dangerWash" },

      "segTrack":       { "ref": "semantic.bgSeg" },
      "segTrackLine":   { "ref": "semantic.line" },
      "segOnBg":        { "ref": "semantic.bgSegOn" },
      "segOnInk":       { "ref": "semantic.ink" },
      "segOffInk":      { "ref": "semantic.ink3" },

      "cardBg":         { "ref": "semantic.bgCard" },
      "cardLine":       { "ref": "semantic.line" },

      "todoRowHover":   { "ref": "semantic.bgField" },
      "todoRowCurrent": { "ref": "semantic.accentWash", "description": "『进行中』行底 14%（取代 45% alpha 高亮）" },
      "todoBarCurrent": { "ref": "semantic.accent", "description": "『进行中』行左 3px 竖条" },
      "todoNameCurrent":{ "ref": "semantic.ink" },
      "todoTimeCurrent":{ "ref": "semantic.accentInk" },
      "todoNameDone":   { "ref": "semantic.ink4", "description": "已完成行名（时长加删除线，text-decoration-color=line3）" },
      "todoMarkRing":   { "ref": "semantic.line3" },
      "todoMarkDone":   { "ref": "semantic.ok" },
      "todoMarkDoneInk":{ "ref": "semantic.okInk" },
      "todoOverdue":    { "ref": "semantic.warn", "via": "--color-warn", "description": "待办逾期（AC-54：改走可配色 --color-warn，默认回落 semantic.warn）" },
      "todoNoTime":     { "ref": "semantic.ink4", "description": "待办未设时间" },
      "todoSummaryInk": { "ref": "semantic.ink3", "description": "表头右侧『共 2 小时 15 分』" },

      "noteBodyBg":     { "ref": "semantic.bgInset" },
      "noteFootInk":    { "ref": "semantic.ink3" },
      "noteConfirmBg":  { "ref": "semantic.dangerWash" },
      "noteConfirmLine":{ "ref": "semantic.danger" },

      "focusRing":      { "dark": "0 0 0 2px #0E1015, 0 0 0 4px #4DA3E8", "light": "0 0 0 2px #FFFFFF, 0 0 0 4px #1669AD", "type": "shadow", "description": "focus-visible 双环；组件只引用 --focus-ring" },
