        "lightBg":  { "value": "#1A1D24", "type": "color" },
        "lightInk": { "value": "#FFFFFF", "type": "color" }
      }
    },

    "semantic": {
      "_comment": "角色层：每个角色给出 dark / light 两值。value 由 primitive 展开（深层结构见 __themeMap）。",

      "bgPlate":   { "dark": "#0E0F12", "light": "#F2F3F5", "type": "color", "role": "A1-identity", "description": "浮层底 ＝ 小条底色。用户可配（--color-bar / settings.accent_bar）" },
      "bgInset":   { "dark": "#1B1E25", "light": "#FFFFFF", "type": "color", "description": "浮层内下沉编辑区（便利贴正文）" },
      "bgPanel":   { "dark": "#0E1015", "light": "#FFFFFF", "type": "color", "description": "常驻窗口外壳（设置面板 / 事项窗口）" },
      "bgCard":    { "dark": "#14161C", "light": "#F7F8FA", "type": "color", "description": "分组卡片" },
      "bgField":   { "dark": "#1B1E25", "light": "#F1F3F7", "type": "color", "description": "输入框 / 控件底" },
      "bgFieldHi": { "dark": "#232833", "light": "#E6E9EF", "type": "color", "description": "控件 hover / neutral 按钮底" },
      "bgSeg":     { "dark": "#171A21", "light": "#EDEFF4", "type": "color", "description": "分段控件槽" },
      "bgSegOn":   { "dark": "#262B36", "light": "#FFFFFF", "type": "color", "description": "分段控件选中段" },

      "line":      { "dark": "rgba(255,255,255,0.06)", "light": "rgba(16,20,28,0.07)", "type": "color", "description": "分隔线 / 卡片描边" },
      "line2":     { "dark": "rgba(255,255,255,0.10)", "light": "rgba(16,20,28,0.12)", "type": "color", "description": "控件描边 / 浮层描边" },
      "line3":     { "dark": "rgba(255,255,255,0.16)", "light": "rgba(16,20,28,0.18)", "type": "color", "description": "hover 描边 / 未完成圆环 / 滚动条" },

      "ink":       { "dark": "#F2F3F5", "light": "#16181D", "type": "color", "description": "正文 17.14:1 / 17.76:1" },
      "ink2":      { "dark": "#C9CED8", "light": "#41485A", "type": "color", "description": "次级 11.46:1 / 9.13:1" },
      "ink3":      { "dark": "#8B93A2", "light": "#5C6577", "type": "color", "description": "三级 6.16:1 / 5.86:1" },
      "ink4":      { "dark": "#7A8292", "light": "#656E7D", "type": "color", "description": "四级 4.93:1 / plate 4.64:1（AC-53：浅色已提升至 ≥4.5:1，可作正文小字）" },

      "accent":     { "dark": "#4DA3E8", "light": "#1669AD", "type": "color", "description": "『计时中』主色。用户可配（--color-running / settings.accent_running）。浅色＝DeepenForNonText" },
      "accentInk":  { "dark": "#8FC6F5", "light": "#1F63AA", "type": "color", "description": "强调底/链接上的前景" },
      "accentWash": { "dark": "color-mix(in srgb, #4DA3E8 14%, transparent)", "light": "color-mix(in srgb, #1669AD 14%, transparent)", "type": "color", "description": "强调底 14%（当前行 / accent 按钮底）" },
      "accentLine": { "dark": "color-mix(in srgb, #4DA3E8 32%, transparent)", "light": "color-mix(in srgb, #1669AD 32%, transparent)", "type": "color", "description": "强调描边 32%" },

      "warn":      { "dark": "#E8A33D", "light": "#A05E00", "type": "color", "description": "『提醒』。用户可配（--color-warn / settings.accent_warn）。浅色对 plate 4.62:1（原 #A76200 仅 4.31）" },
      "warnWash":  { "dark": "color-mix(in srgb, #E8A33D 12%, transparent)", "light": "color-mix(in srgb, #A05E00 12%, transparent)", "type": "color" },
      "danger":    { "dark": "#E5484D", "light": "#D02C33", "type": "color", "description": "破坏性操作，仅用于销毁数据类动作。浅色对 plate 4.62:1（原 #D4353B 仅 4.33）" },
      "dangerWash":{ "dark": "color-mix(in srgb, #E5484D 12%, transparent)", "light": "color-mix(in srgb, #D02C33 12%, transparent)", "type": "color" },
      "ok":        { "dark": "#4CC38A", "light": "#0C7E47", "type": "color", "description": "『完成』。用户可配（--color-done / settings.accent_done）。浅色对 plate 4.62:1（原 #0C834A 仅 4.34）" },
      "dangerSolid": { "dark": "#E1292F", "light": "#D02C33", "type": "color", "description": "AC-53：danger **实心底**专用（白字 ≥4.5）；非文本描边/色点仍用 danger" },
      "okInk":     { "dark": "#06251A", "light": "#FFFFFF", "type": "color", "description": "勾画在 ok 实心圆上的前景（深 7.36:1）" },

      "solidBg":   { "dark": "#EDEFF3", "light": "#1A1D24", "type": "color", "description": "实心主按钮底（仅确认型对话框）" },
      "solidInk":  { "dark": "#0B0C10", "light": "#FFFFFF", "type": "color", "description": "实心主按钮字" },
      "track":     { "dark": "rgba(255,255,255,0.09)", "light": "rgba(16,20,28,0.11)", "type": "color", "description": "滑条轨道 / 开关槽" },
      "scrim":     { "dark": "rgba(14,15,18,0.56)", "light": "rgba(16,20,28,0.32)", "type": "color", "description": "对话框遮罩（不叠加 backdrop-filter）" }
    },

    "component": {
      "_comment": "组件层：B-slot（≥2 处复用的别名）+ C-extension（项目专属）。每项以 ref 指向 semantic 角色。",
      "pillBg":        { "ref": "semantic.bgPlate", "description": "小条底（用户可配 --color-bar）" },
      "pillBorderIn":  { "ref": "semantic.line2", "description": "小条内描边 1px" },
      "pillHoverPlate":{ "ref": "semantic.bgPlate", "modifier": "alpha-74 + blur-14", "description": "小条悬停板（玻璃，见 glass）" },
      "gripInk":       { "dark": "rgba(255,255,255,0.74)", "light": "rgba(16,20,28,0.55)", "type": "color", "description": "拖拽柄（仅 hover 显示）" },

      "menuBg":         { "ref": "semantic.bgPlate", "modifier": "alpha-94 + blur-18", "description": "菜单 / 事项窗口玻璃底" },
      "menuItemHover":  { "ref": "semantic.bgFieldHi" },
      "menuText":       { "ref": "semantic.ink2" },
      "menuTextOn":     { "ref": "semantic.ink" },
      "menuDanger":     { "ref": "semantic.danger" },
      "menuGroupLabel": { "ref": "semantic.ink4" },

