  }

  class HostIntentGateway {
    <<V · platform/runtime/hostIntentGateway.ts (新)>>
    +emitHostIntent(intent) Promise~void~
  }

  class HostIntentBridge {
    <<H · src/services/hostIntentBridge.ts (新)>>
    +useHostIntentBridge(actions) void
    -dispatch(intent) Promise~void~
  }

  %% ---------------- 历史时间线 ----------------

  class HistoryTimelineViewModel {
