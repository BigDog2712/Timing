classDiagram
  %% FUSION-ARCH-v1 · 数据结构与接口（两窗 + 融合层）
  %% 约定：H = 宿主自有文件，V = vendored（改动须登记）

  %% ---------------- 跨窗 DTO ----------------

  class PatinaOpenTarget {
    <<H · src/types/domain/ipc.ts>>
    +history: HistoryOpenTarget
  }

  class HistoryOpenTarget {
    +dateKey: string
    +focusApp: string | null
  }

  class MainWindowTargetDto {
    <<Rust · serde camelCase>>
    +tools: ToolsSection | None
    +history: HistoryTarget | None
  }

  class HistoryTarget {
    +date_key: String
    +focus_app: Option~String~
  }

  class ToolsSection {
    <<Rust enum, snake_case>>
    +Pomodoro
    +Reminders
  }

  class MainWindowTarget {
    <<Rust enum, pub(crate)>>
    +Tools(ToolsSection)
    +History(HistoryTarget)
  }

  class ToolsNavigationState {
    <<V · tools_navigation.rs>>
    -inner: Mutex~Option~MainWindowTarget~~
    +take() Option~MainWindowTarget~
  }

  class HostIntent {
    <<H/V 两侧同构 union>>
    +action: start_timer_for_activity | toggle_timer | open_host_settings | show_pill
    +itemName: string
  }

  %% ---------------- 宿主四色 ----------------

  class AccentColors {
    <<host DTO>>
    +running: string
    +warn: string
    +done: string
    +bar: string | null
  }

  class ThemeChanged {
    <<host event payload>>
    +mode: ThemeMode
    +accents: AccentColors
  }

  class HostAccentBridge {
    <<V · shared/theme/hostAccentBridge.ts (新)>>
    +applyHostAccents(tokens, accents, variant) Record~string,string~
    -primaryButtonBackground(accent) string
    -deepenForNonText(hex, bgLum, target) string
    -deepenForText(hex, bgLum, target) string
    -isValidHex(v) boolean
  }

  class DeriveTheme {
    <<V · shared/theme/deriveTheme.ts (改: 仅 export)>>
    +deriveTheme(variant, scheme, override) Record~string,string~
    +primaryButtonBackground(accent) string
  }

  class HostThemeGateway {
    <<V · platform/runtime/hostThemeGateway.ts (改)>>
    +readHostThemeMode() ThemeMode | null
    +readHostAccents() AccentColors | null
    +subscribeHostThemeMode(onMode, onAccents) UnlistenFn | null
  }

  class UseHostTheme {
    <<V · app/hooks/useHostThemeMode.ts (改)>>
    +useHostTheme(localMode) HostTheme
  }

  class HostTheme {
    +mode: ThemeMode
    +accents: AccentColors | null
  }

  class ApplyDocumentTheme {
    <<V · app/hooks/useAppThemeMode.ts (改)>>
    +applyDocumentTheme(mode, effective, scheme) void
  }

  class HostThemeMode {
    <<H · src-tauri/permissions/patina-host-theme.toml>>
    +commands.allow: theme_get, accent_get
  }

  %% ---------------- 计时态 ----------------

  class TimerState {
    <<host event payload>>
    +status: idle | running | paused
    +session: TimeRecord | null
    +lastItemId: number | null
    +liveDurationSec: number
    +mode: countup | countdown
    +remainingSec: number | null
  }

  class TimeRecord {
    <<host DTO>>
    +id: number
    +itemId: number
    +startedAt: number
    +endedAt: number | null
    +accumulatedSec: number
    +runningSince: number | null
    +mode: TimerMode
    +targetSec: number | null
  }

  class HostTimerGateway {
    <<V · platform/runtime/hostTimerGateway.ts (新)>>
    +subscribeHostTimerState(onState) UnlistenFn | null
    +loadHostItems() TimingItemName[]
    +computeHostLiveSec(session) number
  }

  class UseHostTimerState {
    <<V · app/hooks/useHostTimerState.ts (新)>>
    +useHostTimerState() HostTimerView
  }

  class HostTimerView {
    +status: string
    +itemName: string | null
    +liveSec: number
    +session: TimeRecord | null
  }

  class TimingCapsule {
    <<V · app/components/TimingCapsule.tsx (新)>>
