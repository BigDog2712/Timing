src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/.gradle/
# buildSrc 有独立的 Kotlin 构建缓存（实测 908 KB），上面四条只覆盖 app/build 级
src-tauri/gen/android/buildSrc/.kotlin/

# --- 构建产物（构建期复制生成，不入库） ---
release/*.exe
release/*.msi
release/*.nsis.zip
# Android 安装包：可执行产物，体积按 MB 计，不入库（构建方式见 归档说明.md §8）
release/*.apk
# 便携版：按版本命名的目录与压缩包（构建产物，不入库）
release/Timing-*/
release/*.zip

# --- 临时 / 本地 ---
*.log
tmp_*
*.pyc
__pycache__/
.DS_Store

# --- 编辑器 / 系统 ---
.vscode/
.idea/
Thumbs.db
Desktop.ini

# --- 本地工作数据（协作工具产物：调试脚本 / 截图 / 笔记，不入库） ---
